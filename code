// ================= SETUP =================
void setup() {
  Serial.begin(9600);

  Serial.println("Talking Gloves Project with Voice Feedback");
  Serial.println("Bending a finger will trigger a corresponding sound...");
}


// ================= LOOP =================
void loop() {

  // Read flex sensor values
  int sensorIndex  = analogRead(flexSensorPinIndex);
  int sensorMiddle = analogRead(flexSensorPinMiddle);
  int sensorRing   = analogRead(flexSensorPinRing);
  int sensorLittle = analogRead(flexSensorPinLittle);

  // Display sensor values
  Serial.print("Index: ");
  Serial.print(sensorIndex);

  Serial.print(" | Middle: ");
  Serial.print(sensorMiddle);

  Serial.print(" | Ring: ");
  Serial.print(sensorRing);

  Serial.print(" | Little: ");
  Serial.println(sensorLittle);


  // Find the most bent finger
  int lowestValue = 1023;
  int mostBentFinger = 0;


  if (sensorIndex < threshold && sensorIndex < lowestValue) {
    lowestValue = sensorIndex;
    mostBentFinger = 1;
  }

  if (sensorMiddle < threshold && sensorMiddle < lowestValue) {
    lowestValue = sensorMiddle;
    mostBentFinger = 2;
  }

  if (sensorRing < threshold && sensorRing < lowestValue) {
    lowestValue = sensorRing;
    mostBentFinger = 3;
  }

  if (sensorLittle < threshold && sensorLittle < lowestValue) {
    lowestValue = sensorLittle;
    mostBentFinger = 4;
  }


  // Play corresponding sound
  switch (mostBentFinger) {

    case 1:
      Serial.println("Index finger bent - Playing Danger sound");
      voice.say(spDANGER);
      break;

    case 2:
      Serial.println("Middle finger bent - Playing Water sound");
      voice.say(spWATER);
      break;

    case 3:
      Serial.println("Ring finger bent - Playing Break sound");
      voice.say(spBREAK);
      break;

    case 4:
      Serial.println("Little finger bent - Playing Service sound");
      voice.say(spSERVICE);
      break;

    default:
      break;
  }


  // Prevent rapid re-triggering
  delay(1000);
}
